"[orthocal_year year=\"2027\"] — yearly calendar\n"
"[orthocal_day date=\"2027-05-02\"] — card for the selected date\n"
"[orthocal_readings date=\"2027-05-02\"] — daily Bible readings\n"
"[orthocal_calendar] — general calendar\n"
"[orthocal_fasting] — fasting and meals\n"
"[orthocal_saints] — saints commemorations\n"
"[orthocal_feasts limit=\"5\"] — feast list\n"
"[orthocal_memorial] — memorial days\n"
"[orthocal_pascha year=\"2027\"] — Pascha date and related information\n"
"[orthocal_fasts year=\"2027\"] — yearly fasts\n"
"[orthocal_date] — new and old style date\n"
"[orthocal_texts] — liturgical texts library\n"
"[orthocal_troparia] — troparia\n"
"[orthocal_kontakia] — kontakia\n"
"[orthocal_prayers] — prayers\n"
"[orthocal_magnifications] — magnifications\n"
"[orthocal_horologion] — full Horologion reference"
